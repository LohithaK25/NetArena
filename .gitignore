# .gitignore

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Go
/bin/
/dist/
/coverage.out
*.test
*.prof

# Node / frontend
node_modules/
web/node_modules/
web/dist/
.npm/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs and temporary output
*.log
tmp/
temp/

# Local Windows executable artifacts
/netarena.exe

# Local NetArena sweep reports
/sweep-report.json
/sweep-report.csv

# Local API server executable
/netarena-server.exe
